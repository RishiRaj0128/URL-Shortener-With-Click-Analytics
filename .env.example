# ==============================================================================
# URL Shortener with Click Analytics - Environment Variables Template
# ==============================================================================
# Copy this file to .env and provide deployment-specific values.
# NEVER commit the actual .env file with secrets into version control.

# Server Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# Relational Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=url_shortener
DB_USER=postgres
DB_PASSWORD=postgres

# Distributed Cache & Stream Coordination (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic Authentication (JWT)
# Must be a high-entropy secret of at least 256 bits (32+ bytes / 64 hex characters)
# Generate via: openssl rand -hex 32
JWT_SECRET=4a8b1c7d2e3f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b

# IP Privacy & HMAC-SHA256 Anonymization
# Secret and optional rotating salt for GDPR-compliant click IP pseudonymization
IP_HASH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
IP_HASH_SALT=2026-Q1

# Snowflake Node Identity
# Unique worker ID across cluster nodes (0 to 1023)
WORKER_NODE_ID=1

# Click Ingestion Stream Queue
APP_QUEUE_IMPL=redis
REDIS_STREAM_KEY=clicks:stream
REDIS_STREAM_GROUP=clicks:consumer-group
REDIS_STREAM_CONSUMER=worker-1
APP_QUEUE_POLL_TIMEOUT_MS=25
APP_QUEUE_PUBLISH_ENABLED=true
APP_CONSUMER_ENABLED=true

# Security & Proxy Trust
APP_SECURITY_TRUSTED_PROXIES=127.0.0.1,::1,172.28.0.100
