  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Redirect Request Throughput (RPS by Status)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(redirect_requests_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Redirect Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(redirect_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50 (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(redirect_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(redirect_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Redis Stream Backlog (Queue Depth)",
      "type": "stat",
      "targets": [
        {
          "expr": "max(click_stream_queue_depth)",
          "legendFormat": "Queue Depth",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Click Ingestion Pipeline Processing Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(click_events_acked[1m]))",
          "legendFormat": "Acked Clicks/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(click_processor_deduplicated[1m]))",
          "legendFormat": "Deduplicated Clicks/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(click_events_dropped[1m]))",
          "legendFormat": "Dropped Clicks/s",
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Resilience4j Circuit Breaker Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{state=\"closed\"}",
          "legendFormat": "{{name}} (Closed)",
          "refId": "A"
        },
        {
          "expr": "resilience4j_circuitbreaker_state{state=\"open\"}",
          "legendFormat": "{{name}} (Open)",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
